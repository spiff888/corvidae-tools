---
interface Props {
  name: string;
  latin: string;
  description: string;
  status: 'live' | 'beta' | 'planned';
  href?: string;
}

const { name, latin, description, status, href } = Astro.props;
const badgeClass = status === 'planned' ? 'badge-planned' : status === 'beta' ? 'badge-beta' : 'badge-live';
const Tag = href ? 'a' : 'div';
---

<Tag class="card" href={href} style={href ? 'text-decoration: none; color: inherit;' : undefined}>
  <div class="card-top">
   <!-- Lucide "bird" icon (ISC license) -->
   <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke={status === 'planned' ? '#5a5a62' : 'var(--accent)'} stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
     <path d="M16 7h.01" />
     <path d="M3.4 18H12a8 8 0 0 0 8-8V7a4 4 0 0 0-7.28-2.3L2 20" />
     <path d="m20 7 2 .5-2 .5" />
     <path d="M10 18v3" />
     <path d="M14 17.75V21" />
     <path d="M7 18a6 6 0 0 0 3.84-10.61" />
   </svg>
    {status !== 'live' && <span class={`badge ${badgeClass}`}>{status.toUpperCase()}</span>}
  </div>
  <div>
    <div class="card-title" style={status === 'planned' ? 'color: #d4d4d9;' : undefined}>{name}</div>
    <div class="card-latin">{latin}</div>
  </div>
  <div class="card-desc" style={status === 'planned' ? 'color: #86868d;' : undefined}>{description}</div>
</Tag>
