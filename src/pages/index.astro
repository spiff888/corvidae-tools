---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools.js';
---

<Layout title="corvidae.tools">
  <Header />

  <p class="tagline">A small flock of browser-based tools. Nothing you drop in here gets uploaded anywhere &mdash; it stays on your machine.</p>

  <div class="field-note">
    <!-- Lucide "bird" icon (ISC license) -->
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--accent)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M16 7h.01" />
      <path d="M3.4 18H12a8 8 0 0 0 8-8V7a4 4 0 0 0-7.28-2.3L2 20" />
      <path d="m20 7 2 .5-2 .5" />
      <path d="M10 18v3" />
      <path d="M14 17.75V21" />
      <path d="M7 18a6 6 0 0 0 3.84-10.61" />
    </svg>
    <span>Corvus corax &mdash; the raven, largest of the corvids, known for problem-solving and tool use.</span>
  </div>

  <div class="grid">
    {tools.map((tool) => (
      <ToolCard
        name={tool.name}
        latin={tool.latin}
        description={tool.description}
        status={tool.status}
        href={tool.href}
      />
    ))}
    <div class="card card-empty">next species, tbd</div>
  </div>

  <Footer />
</Layout>
