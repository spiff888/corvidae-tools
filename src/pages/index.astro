---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools.js';
---

<Layout title="corvidae.tools">
  <Header />

  <p class="tagline">A small flock of browser-based tools. Nothing you drop in here gets uploaded anywhere &mdash; it stays on your machine.</p>

  <div class="field-note">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--accent)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 14c2-3 5-4 7-3 1-3 4-5 7-4-1 2-3 3-3 3s3 0 4 2c-2 0-4 1-5 3-1 2-3 3-5 3-1-2-3-3-5-4z"></path>
    </svg>
    <span>Corvus corax &mdash; the raven, largest of the corvids, known for problem-solving and tool use.</span>
  </div>

  <div class="grid">
    {tools.map((tool) => (
      <ToolCard
        name={tool.name}
        latin={tool.latin}
        description={tool.description}
        status={tool.status}
        href={tool.href}
      />
    ))}
    <div class="card card-empty">next species, tbd</div>
  </div>

  <Footer />
</Layout>
