---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Rook — IPv4 & IPv6 subnet calculator — corvidae.tools" description="Calculate subnets for IPv4 and IPv6 from an address and prefix length: network, range, masks, address type and reverse DNS, entirely in your browser.">
  <a href="/" class="back-link">&larr; corvidae.tools</a>

  <div style="display: flex; align-items: center; gap: 40px; flex-wrap: wrap; margin-bottom: 8px;">
    <div style="flex: 1; min-width: 260px;">
      <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 4px;">
        <h1 style="font-size: 32px; margin: 0;">Rook</h1>
        <span style="font-family: var(--font-mono); font-style: italic; font-size: 14px; color: var(--text-faint);">Corvus frugilegus</span>
      </div>
      <p class="tagline" style="margin-top: 8px; margin-bottom: 0;">Enter an address and a prefix length to get the network, range and host counts. IPv4 and IPv6, all in your browser.</p>
    </div>
    <img src="/rook-mark.png" alt="" width="220" style="width: 220px; height: auto; flex-shrink: 0;" />
  </div>

  <div class="tabs" role="tablist" aria-label="Rook calculators">
    <button type="button" class="tab" role="tab" id="tab-ipv4" aria-controls="panel-ipv4" aria-selected="true">IPv4</button>
    <button type="button" class="tab" role="tab" id="tab-ipv6" aria-controls="panel-ipv6" aria-selected="false" tabindex="-1">IPv6</button>
  </div>

  <div id="panel-ipv4" role="tabpanel" aria-labelledby="tab-ipv4">
    <div style="display: flex; gap: 24px; flex-wrap: wrap; align-items: flex-end; margin: 32px 0;">
      <div>
        <label for="ip-input" style="display: block; font-family: var(--font-mono); font-size: 13px; color: var(--text-dim); margin-bottom: 8px;">IP address</label>
        <input type="text" id="ip-input" value="192.168.1.10" spellcheck="false" style="background: var(--bg-card); border: 1px solid var(--border); color: var(--text); padding: 10px 14px; border-radius: 8px; font-family: var(--font-mono); font-size: 14px; width: 220px;" />
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="font-family: var(--font-mono); font-size: 20px; color: var(--text-faint); padding-bottom: 10px;">/</span>
        <div>
          <label for="cidr-input" style="display: block; font-family: var(--font-mono); font-size: 13px; color: var(--text-dim); margin-bottom: 8px;">CIDR prefix</label>
          <input type="number" id="cidr-input" value="24" min="0" max="32" style="background: var(--bg-card); border: 1px solid var(--border); color: var(--text); padding: 10px 14px; border-radius: 8px; font-family: var(--font-mono); font-size: 14px; width: 90px;" />
        </div>
      </div>
    </div>

    <div id="error-msg" style="display: none; background: #2a1414; border: 1px solid #6b1f1f; border-radius: 12px; padding: 16px 20px; margin-bottom: 24px; font-size: 14px; color: #e08a8a; font-family: var(--font-mono);"></div>

    <div id="results" style="display: none;">
      <div class="card" style="max-width: 560px; padding: 0; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: 14px;">
          <tbody id="results-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="panel-ipv6" role="tabpanel" aria-labelledby="tab-ipv6" hidden>
    <div style="display: flex; gap: 24px; flex-wrap: wrap; align-items: flex-end; margin: 32px 0 12px;">
      <div style="flex: 1 1 320px; max-width: 400px;">
        <label for="ip6-input" style="display: block; font-family: var(--font-mono); font-size: 13px; color: var(--text-dim); margin-bottom: 8px;">IPv6 address</label>
        <input type="text" id="ip6-input" value="2001:db8:abcd:12::1" spellcheck="false" autocomplete="off" style="box-sizing: border-box; background: var(--bg-card); border: 1px solid var(--border); color: var(--text); padding: 10px 14px; border-radius: 8px; font-family: var(--font-mono); font-size: 14px; width: 100%;" />
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="font-family: var(--font-mono); font-size: 20px; color: var(--text-faint); padding-bottom: 10px;">/</span>
        <div>
          <label for="prefix6-input" style="display: block; font-family: var(--font-mono); font-size: 13px; color: var(--text-dim); margin-bottom: 8px;">Prefix length</label>
          <input type="number" id="prefix6-input" value="64" min="0" max="128" style="background: var(--bg-card); border: 1px solid var(--border); color: var(--text); padding: 10px 14px; border-radius: 8px; font-family: var(--font-mono); font-size: 14px; width: 90px;" />
        </div>
      </div>
    </div>
    <p style="font-family: var(--font-mono); font-size: 12px; color: var(--text-faint); margin: 0 0 24px;">Tip: you can paste a whole prefix like 2001:db8::/32 into the address box.</p>

    <div id="error6-msg" style="display: none; background: #2a1414; border: 1px solid #6b1f1f; border-radius: 12px; padding: 16px 20px; margin-bottom: 24px; font-size: 14px; color: #e08a8a; font-family: var(--font-mono);"></div>

    <div id="results6" style="display: none;">
      <div class="card" style="max-width: 720px; padding: 0; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: 14px;">
          <tbody id="results6-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  /* Tabs (same look as Blue Jay) */
  .tabs {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 24px 0 8px;
  }
  .tab {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 18px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
    cursor: pointer;
  }
  .tab[aria-selected='true'] {
    background: var(--bg-card);
    border-color: var(--accent);
    color: var(--accent);
  }
  .tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Rows and cells are built by script, so they need :global() to pick up these rules (same approach as Blue Jay). */
  #results-body :global(tr),
  #results6-body :global(tr) {
    border-bottom: 1px solid var(--border);
  }
  #results-body :global(tr:last-child),
  #results6-body :global(tr:last-child) {
    border-bottom: none;
  }
  #results-body :global(td),
  #results6-body :global(td) {
    padding: 14px 20px;
  }
  #results-body :global(td:first-child),
  #results6-body :global(td:first-child) {
    color: var(--text-faint);
    white-space: nowrap;
  }
  #results-body :global(td:last-child),
  #results6-body :global(td:last-child) {
    color: var(--text);
    text-align: right;
    font-weight: 700;
  }
  /* Long IPv6 values (expanded addresses, ip6.arpa names) wrap instead of being clipped */
  #results6-body :global(td:last-child) {
    overflow-wrap: anywhere;
  }
  /* On phones, stack each IPv6 row (label above value) so long values get the full width */
  @media (max-width: 600px) {
    #results6-body :global(tr) {
      display: block;
      padding: 12px 16px;
    }
    #results6-body :global(td) {
      display: block;
      padding: 0;
    }
    #results6-body :global(td:first-child) {
      font-size: 12px;
      margin-bottom: 4px;
    }
    #results6-body :global(td:last-child) {
      text-align: left;
    }
  }
</style>

<script>
  // ---------- Tabs ----------
  const tabs = [
    { btn: document.getElementById('tab-ipv4') as HTMLButtonElement, panel: document.getElementById('panel-ipv4') as HTMLDivElement, hash: '' },
    { btn: document.getElementById('tab-ipv6') as HTMLButtonElement, panel: document.getElementById('panel-ipv6') as HTMLDivElement, hash: '#ipv6' }
  ];

  function showTab(index: number, updateHash = true) {
    tabs.forEach((t, i) => {
      t.btn.setAttribute('aria-selected', String(i === index));
      t.btn.tabIndex = i === index ? 0 : -1;
      t.panel.hidden = i !== index;
    });
    if (updateHash) history.replaceState(null, '', tabs[index].hash || location.pathname);
  }

  tabs.forEach((t, i) => {
    t.btn.addEventListener('click', () => showTab(i));
    t.btn.addEventListener('keydown', (e: KeyboardEvent) => {
      let next = -1;
      if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      if (next !== -1) {
        e.preventDefault();
        showTab(next);
        tabs[next].btn.focus();
      }
    });
  });

  showTab(location.hash === '#ipv6' ? 1 : 0, false);
  // Editing the hash on the page you're already on doesn't reload it, so follow it here too.
  window.addEventListener('hashchange', () => showTab(location.hash === '#ipv6' ? 1 : 0, false));

  // ---------- IPv4 ----------
  const ipInput = document.getElementById('ip-input') as HTMLInputElement;
  const cidrInput = document.getElementById('cidr-input') as HTMLInputElement;
  const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
  const results = document.getElementById('results') as HTMLDivElement;
  const resultsBody = document.getElementById('results-body') as HTMLTableSectionElement;

  function parseIp(ip: string): number | null {
    const parts = ip.trim().split('.');
    if (parts.length !== 4) return null;
    let value = 0;
    for (const part of parts) {
      if (!/^\d{1,3}$/.test(part)) return null;
      const n = Number(part);
      if (n < 0 || n > 255) return null;
      value = (value << 8) | n;
    }
    return value >>> 0;
  }

  function intToIp(n: number): string {
    return [24, 16, 8, 0].map((shift) => (n >>> shift) & 0xff).join('.');
  }

  function calculate() {
    const ipStr = ipInput.value;
    const cidr = Number(cidrInput.value);

    const ipInt = parseIp(ipStr);
    if (ipInt === null) {
      showError('That doesn\u2019t look like a valid IPv4 address (expected four numbers 0\u2013255, separated by dots).');
      return;
    }
    if (!Number.isInteger(cidr) || cidr < 0 || cidr > 32) {
      showError('CIDR prefix must be a whole number between 0 and 32.');
      return;
    }

    errorMsg.style.display = 'none';

    const mask = cidr === 0 ? 0 : (0xffffffff << (32 - cidr)) >>> 0;
    const wildcard = (~mask) >>> 0;
    const network = (ipInt & mask) >>> 0;
    const broadcast = (network | wildcard) >>> 0;
    const total = Math.pow(2, 32 - cidr);

    let firstHost: string, lastHost: string, usable: number;
    if (cidr === 32) {
      firstHost = intToIp(ipInt);
      lastHost = intToIp(ipInt);
      usable = 1;
    } else if (cidr === 31) {
      firstHost = intToIp(network);
      lastHost = intToIp(broadcast);
      usable = 2;
    } else {
      firstHost = intToIp((network + 1) >>> 0);
      lastHost = intToIp((broadcast - 1) >>> 0);
      usable = total - 2;
    }

    const rows: [string, string][] = [
      ['Network address', intToIp(network)],
      ['Broadcast address', intToIp(broadcast)],
      ['Subnet mask', intToIp(mask)],
      ['Wildcard mask', intToIp(wildcard)],
      ['First usable host', firstHost],
      ['Last usable host', lastHost],
      ['Total addresses', total.toLocaleString()],
      ['Usable hosts', usable.toLocaleString()]
    ];

    resultsBody.innerHTML = '';
    for (const [label, value] of rows) {
      const tr = document.createElement('tr');
      const tdLabel = document.createElement('td');
      tdLabel.textContent = label;
      const tdValue = document.createElement('td');
      tdValue.textContent = value;
      tr.append(tdLabel, tdValue);
      resultsBody.appendChild(tr);
    }

    results.style.display = 'block';
  }

  function showError(message: string) {
    errorMsg.textContent = message;
    errorMsg.style.display = 'block';
    results.style.display = 'none';
  }

  ipInput.addEventListener('input', calculate);
  cidrInput.addEventListener('input', calculate);
  calculate();

  // ---------- IPv6 ----------
  // <ipv6-core>
  const ALL_ONES = (1n << 128n) - 1n;

  function parseIPv4Tail(s: string): number[] | null {
    const parts = s.split('.');
    if (parts.length !== 4) return null;
    const out: number[] = [];
    for (const p of parts) {
      if (!/^\d{1,3}$/.test(p)) return null;
      const n = Number(p);
      if (n > 255) return null;
      out.push(n);
    }
    return out;
  }

  function parseIPv6(input: string): { value: bigint } | { error: string } {
    let s = input.trim();
    const zone = s.indexOf('%');
    if (zone !== -1) s = s.slice(0, zone);
    if (s === '') return { error: 'Enter an IPv6 address.' };
    if (!/^[0-9a-fA-F:.]+$/.test(s)) {
      return { error: 'IPv6 addresses use only hex digits (0–9, a–f) and colons.' };
    }

    // Embedded IPv4 in the last 32 bits, e.g. ::ffff:192.0.2.1
    if (s.includes('.')) {
      const cut = s.lastIndexOf(':');
      const v4 = cut === -1 ? null : parseIPv4Tail(s.slice(cut + 1));
      if (!v4) {
        return { error: 'The dotted part must be a valid IPv4 address at the very end, like ::ffff:192.0.2.1.' };
      }
      const hi = ((v4[0] << 8) | v4[1]).toString(16);
      const lo = ((v4[2] << 8) | v4[3]).toString(16);
      s = s.slice(0, cut + 1) + hi + ':' + lo;
    }

    const halves = s.split('::');
    if (halves.length > 2) return { error: 'An IPv6 address can contain “::” only once.' };

    const toGroups = (part: string) => (part === '' ? [] : part.split(':'));
    let groups: string[];
    if (halves.length === 2) {
      const head = toGroups(halves[0]);
      const tail = toGroups(halves[1]);
      const missing = 8 - head.length - tail.length;
      if (missing < 1) return { error: 'Too many groups for an address that uses “::”.' };
      groups = [...head, ...Array(missing).fill('0'), ...tail];
    } else {
      groups = s.split(':');
      if (groups.length !== 8) {
        return {
          error:
            groups.length < 8
              ? 'Not enough groups: write all 8, or use “::” for a run of zeros.'
              : 'Too many groups: an IPv6 address has 8.'
        };
      }
    }

    let value = 0n;
    for (const g of groups) {
      if (!/^[0-9a-fA-F]{1,4}$/.test(g)) return { error: 'Each group must be 1–4 hex digits.' };
      value = (value << 16n) | BigInt('0x' + g);
    }
    return { value };
  }

  function groupsOf(v: bigint): number[] {
    const g: number[] = [];
    for (let i = 7; i >= 0; i--) g.push(Number((v >> BigInt(i * 16)) & 0xffffn));
    return g;
  }

  function expandIPv6(v: bigint): string {
    return groupsOf(v)
      .map((g) => g.toString(16).padStart(4, '0'))
      .join(':');
  }

  // RFC 5952: lowercase, no leading zeros, longest run of 2+ zero groups becomes "::" (first run wins a tie)
  function compressIPv6(v: bigint): string {
    const g = groupsOf(v);
    let bestStart = -1;
    let bestLen = 0;
    for (let i = 0; i < 8; ) {
      if (g[i] !== 0) {
        i++;
        continue;
      }
      let j = i;
      while (j < 8 && g[j] === 0) j++;
      if (j - i > bestLen) {
        bestStart = i;
        bestLen = j - i;
      }
      i = j;
    }
    const hex = g.map((x) => x.toString(16));
    if (bestLen < 2) return hex.join(':');
    return hex.slice(0, bestStart).join(':') + '::' + hex.slice(bestStart + bestLen).join(':');
  }

  function prefixMask(p: number): bigint {
    return p === 0 ? 0n : (ALL_ONES << BigInt(128 - p)) & ALL_ONES;
  }

  function inPrefix(v: bigint, base: bigint, len: number): boolean {
    const m = prefixMask(len);
    return (v & m) === (base & m);
  }

  const MULTICAST_SCOPES: Record<number, string> = {
    1: 'interface-local',
    2: 'link-local',
    3: 'realm-local',
    4: 'admin-local',
    5: 'site-local',
    8: 'organization-local',
    14: 'global'
  };

  function classifyIPv6(v: bigint): string {
    if (v === 0n) return 'Unspecified address (::)';
    if (v === 1n) return 'Loopback (::1)';
    if (inPrefix(v, 0xffffn << 32n, 96)) return 'IPv4-mapped (::ffff:0:0/96)';
    if (inPrefix(v, 0x20010db8n << 96n, 32)) return 'Documentation (2001:db8::/32)';
    if (inPrefix(v, 0xfe80n << 112n, 10)) return 'Link-local unicast (fe80::/10)';
    if (inPrefix(v, 0xfc00n << 112n, 7)) return 'Unique local address (fc00::/7)';
    if (inPrefix(v, 0xffn << 120n, 8)) {
      const scope = Number((v >> 112n) & 0xfn);
      const name = MULTICAST_SCOPES[scope] ?? 'scope ' + scope.toString(16);
      return 'Multicast (' + name + ', ff00::/8)';
    }
    if (inPrefix(v, 0x2000n << 112n, 3)) return 'Global unicast (2000::/3)';
    return 'Reserved or unassigned';
  }

  // Reverse DNS name built from the first `nibbleCount` hex digits (32 = full PTR name)
  function reverseName(v: bigint, nibbleCount: number): string {
    const n = expandIPv6(v).replace(/:/g, '').split('').slice(0, nibbleCount).reverse();
    return n.length ? n.join('.') + '.ip6.arpa' : 'ip6.arpa';
  }

  function formatCount(n: bigint, bits: number): string {
    const s = n.toLocaleString('en-US');
    return bits >= 16 ? s + ' (2^' + bits + ')' : s;
  }
  // </ipv6-core>

  const ip6Input = document.getElementById('ip6-input') as HTMLInputElement;
  const prefix6Input = document.getElementById('prefix6-input') as HTMLInputElement;
  const error6 = document.getElementById('error6-msg') as HTMLDivElement;
  const results6 = document.getElementById('results6') as HTMLDivElement;
  const results6Body = document.getElementById('results6-body') as HTMLTableSectionElement;

  // Accept "2001:db8::/32" in the address box: the part after the slash overrides the prefix field.
  function splitAddress(raw: string): { addr: string; len: string | null } {
    const slash = raw.indexOf('/');
    if (slash === -1) return { addr: raw, len: null };
    return { addr: raw.slice(0, slash), len: raw.slice(slash + 1).trim() };
  }

  function calculate6() {
    const { addr, len } = splitAddress(ip6Input.value);
    const parsed = parseIPv6(addr);
    if ('error' in parsed) {
      showError6(parsed.error);
      return;
    }
    const rawPrefix = (len ?? prefix6Input.value).trim();
    if (!/^\d{1,3}$/.test(rawPrefix) || Number(rawPrefix) > 128) {
      showError6('Prefix length must be a whole number between 0 and 128.');
      return;
    }

    error6.style.display = 'none';

    const v = parsed.value;
    const p = Number(rawPrefix);
    const hostBits = 128 - p;
    const network = v & prefixMask(p);
    const last = network | ((1n << BigInt(hostBits)) - 1n);
    const total = 1n << BigInt(hostBits);

    let subnets64: string;
    if (p < 64) subnets64 = formatCount(1n << BigInt(64 - p), 64 - p);
    else if (p === 64) subnets64 = 'This is a single /64';
    else subnets64 = 'Smaller than a /64 (SLAAC needs a /64)';

    const rows: [string, string][] = [
      ['Address (compressed)', compressIPv6(v)],
      ['Address (expanded)', expandIPv6(v)],
      ['Network', compressIPv6(network) + '/' + p],
      ['Network (expanded)', expandIPv6(network)],
      ['First address', compressIPv6(network)],
      ['Last address', compressIPv6(last)],
      ['Total addresses', formatCount(total, hostBits)],
      ['/64 subnets inside', subnets64],
      ['Address type', classifyIPv6(v)]
    ];
    if (p % 4 === 0) rows.push(['Reverse DNS zone', reverseName(network, p / 4)]);
    rows.push(['Reverse DNS (address)', reverseName(v, 32)]);
    if (p === 127) rows.push(['Note', 'Point-to-point link: both addresses are usable (RFC 6164).']);
    if (p === 128) rows.push(['Note', 'Single host address.']);

    results6Body.innerHTML = '';
    for (const [label, value] of rows) {
      const tr = document.createElement('tr');
      const tdLabel = document.createElement('td');
      tdLabel.textContent = label;
      const tdValue = document.createElement('td');
      tdValue.textContent = value;
      tr.append(tdLabel, tdValue);
      results6Body.appendChild(tr);
    }

    results6.style.display = 'block';
  }

  function showError6(message: string) {
    error6.textContent = message;
    error6.style.display = 'block';
    results6.style.display = 'none';
  }

  ip6Input.addEventListener('input', calculate6);
  prefix6Input.addEventListener('input', calculate6);
  // When the user leaves the box, move a pasted "/len" into the prefix field so both stay in sync.
  ip6Input.addEventListener('change', () => {
    const { addr, len } = splitAddress(ip6Input.value);
    if (len !== null && /^\d{1,3}$/.test(len)) {
      ip6Input.value = addr.trim();
      prefix6Input.value = len;
      calculate6();
    }
  });
  calculate6();
</script>
