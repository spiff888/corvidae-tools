---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';

const switches = Array.from({ length: 10 }, (_, i) => ({
  n: i + 1,
  weight: i < 9 ? 2 ** i : null
}));

const universeRows = [
  ['u-console', 'Universe / address'],
  ['u-absolute', 'Absolute address'],
  ['u-range', 'This universe spans'],
  ['u-sacn', 'sACN universe'],
  ['u-mcast', 'sACN multicast group'],
  ['u-artnet', 'Art-Net port-address'],
  ['u-artnet-split', 'Art-Net net / sub-net / universe']
];
---

<Layout title="Blue Jay — DMX DIP switch & address calculator — corvidae.tools" description="Convert DMX addresses to DIP switch settings and back, and translate between universe, absolute, Art-Net and sACN addressing, patch a rig and estimate its power load, entirely in your browser.">
  <a href="/" class="back-link">&larr; corvidae.tools</a>

  <div style="display: flex; align-items: center; gap: 40px; flex-wrap: wrap; margin-bottom: 8px;">
    <div style="flex: 1; min-width: 260px;">
      <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 4px;">
        <h1 style="font-size: 32px; margin: 0;">Blue Jay</h1>
        <span style="font-family: var(--font-mono); font-style: italic; font-size: 14px; color: var(--text-faint);">Cyanocitta cristata</span>
      </div>
      <p class="tagline" style="margin-top: 8px; margin-bottom: 0;">Set a fixture's DIP switches from a DMX address (or read the address off the switches), translate universes between console, Art-Net and sACN numbering, patch a whole rig, and estimate its power load.</p>
    </div>
    <img src="/blue-jay-mark.webp" alt="" width="220" height="239" style="width: 220px; height: auto; flex-shrink: 0;" />
  </div>

  <div class="tabs" role="tablist" aria-label="Blue Jay tools">
    <button type="button" class="tab" role="tab" id="tab-addressing" aria-controls="panel-addressing" aria-selected="true">Addressing</button>
    <button type="button" class="tab" role="tab" id="tab-patch" aria-controls="panel-patch" aria-selected="false">Patch planner</button>
    <button type="button" class="tab" role="tab" id="tab-power" aria-controls="panel-power" aria-selected="false">Power</button>
  </div>

  <div id="panel-addressing" role="tabpanel" aria-labelledby="tab-addressing">
  <!-- DIP switches -->
  <section class="section">
    <h2>DIP switches</h2>
    <p class="hint">Type an address or flip the switches. Switches 1&ndash;9 add up to the address; switch 10 is usually a mode or termination switch.</p>

    <div class="row">
      <div>
        <label for="addr-input">DMX address</label>
        <input type="number" id="addr-input" class="field" min="1" max="512" value="1" style="width: 120px;" />
      </div>
      <div>
        <label for="footprint-input">Fixture channels</label>
        <input type="number" id="footprint-input" class="field" min="1" max="512" value="1" style="width: 120px;" />
      </div>
      <div>
        <label for="mode-select">Fixture convention</label>
        <select id="mode-select" class="field">
          <option value="sum" selected>Address = switch total</option>
          <option value="plus1">Address = switch total + 1</option>
        </select>
      </div>
    </div>

    <div class="dip" role="group" aria-label="DIP switch bank">
      <span class="dip-on" aria-hidden="true">ON &uarr;</span>
      <div class="dip-switches">
        {switches.map((s) => (
          <div class="dip-col">
            <button type="button" class="dip-switch" data-n={s.n} aria-pressed="false" aria-label={`Switch ${s.n}${s.weight ? `, worth ${s.weight}` : ', not part of the address'}`}>
              <span class="dip-knob"></span>
            </button>
            <span class="dip-num">{s.n}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="dip-weights" aria-hidden="true">
      {switches.map((s) => <span>{s.weight ?? '\u2014'}</span>)}
    </div>

    <p id="dip-summary" class="summary"></p>
    <p id="dip-warning" class="warning" style="display: none;"></p>
  </section>

  <!-- Universe conversion -->
  <section class="section">
    <h2>Universe and address</h2>
    <p class="hint">Enter an absolute address (<code>557</code>) or a universe and address (<code>2.45</code>, <code>2/45</code>).</p>

    <div class="row">
      <div>
        <label for="u-input">Address</label>
        <input type="text" id="u-input" class="field" value="2.45" spellcheck="false" autocomplete="off" data-1p-ignore data-lpignore="true" style="width: 200px;" />
      </div>
      <div>
        <label for="u-base">Universe numbering you typed</label>
        <select id="u-base" class="field">
          <option value="1" selected>Starts at 1 (most consoles, sACN)</option>
          <option value="0">Starts at 0 (Art-Net)</option>
        </select>
      </div>
    </div>

    <p id="u-error" class="warning" style="display: none;"></p>

    <div id="u-results" class="results">
      <table>
        <tbody>
          {universeRows.map(([id, label]) => (
            <tr>
              <td>{label}</td>
              <td id={id}></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="hint" style="margin-top: 12px;">Art-Net counts universes from 0 and sACN from 1, so console universe 1 is Art-Net 0. If a fixture responds one universe off, this is usually why.</p>
  </section>

  </div>

  <div id="panel-patch" role="tabpanel" aria-labelledby="tab-patch" hidden>
    <section class="section">
      <h2>Patch planner</h2>
      <p class="hint">List your fixture types with their channel count and quantity. Addresses are assigned in order, and a fixture that won&rsquo;t fit in what&rsquo;s left of a universe starts on the next one. Your list is saved in this browser.</p>

      <div class="row">
        <div>
          <label for="p-start-universe">Start universe</label>
          <input type="number" id="p-start-universe" class="field" min="1" value="1" style="width: 120px;" />
        </div>
        <div>
          <label for="p-start-address">Start address</label>
          <input type="number" id="p-start-address" class="field" min="1" max="512" value="1" style="width: 120px;" />
        </div>
        <div>
          <label for="p-split">Universe boundaries</label>
          <select id="p-split" class="field">
            <option value="no" selected>Never split a fixture</option>
            <option value="yes">Allow splitting (pack tightly)</option>
          </select>
        </div>
      </div>

      <div class="fixture-head" aria-hidden="true">
        <span>Fixture</span><span>Channels</span><span>Watts</span><span>Qty</span><span>Start (optional)</span><span>Zone (optional)</span><span></span>
      </div>
      <div id="fixture-list"></div>
      <p class="hint" style="margin: 12px 0 0;">Channels is the fixture's DMX mode (for example 7CH or 36CH), shown in its menu or manual, not the number of lamps. Watts is what one fixture draws, from its label or spec sheet; it feeds the Power tab and isn't used for addressing. Start is optional: type a universe and address such as <code>5.1</code> to begin that fixture group there (for example, to give a group its own node output), or leave it blank to continue after the previous group. Zone is also optional: name where that group hangs (Catwalk 1, Floor, Stage Right Floor). The Power tab never puts fixtures from different zones on the same circuit.</p><datalist id="zone-list"></datalist>

      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin: 16px 0 32px;">
        <button type="button" id="p-add" class="btn-primary">Add fixture</button>
        <button type="button" id="p-csv" class="btn-secondary">Download CSV</button>
        <button type="button" id="p-clear" class="btn-secondary">Clear list</button>
      </div>

      <p id="p-summary" class="summary" style="margin-top: 0;"></p>
      <p id="p-warning" class="warning" style="display: none;"></p>

      <div id="p-universes" class="results patch-results" style="margin-top: 20px; display: none;">
        <div class="scroll">
          <table class="stack">
            <thead class="stack-head">
              <tr><th>Universe</th><th>Channels used</th><th>Free</th><th>Contains</th></tr>
            </thead>
            <tbody id="p-ubody"></tbody>
          </table>
        </div>
      </div>

      <div id="p-output" class="results patch-results" style="margin-top: 20px;">
        <div class="scroll">
          <table>
            <thead>
              <tr><th>Fixture</th><th>Universe</th><th>Address</th><th>Channels</th><th>Console</th><th>DIP on</th></tr>
            </thead>
            <tbody id="p-body"></tbody>
          </table>
        </div>
      </div>
      <p class="hint" style="margin-top: 12px;">The DIP column follows the fixture convention set on the Addressing tab.</p>
    </section>
  </div>

  <div id="panel-power" role="tabpanel" aria-labelledby="tab-power" hidden>
    <section class="section">
      <h2>Fixtures per circuit</h2>
      <p class="hint">A quick check for one fixture type: how many fit on a 15, 20 or 30 A circuit, loaded to 80% of the breaker rating. For a whole rig, use the estimate below.</p>
      <div class="row">
        <div>
          <label for="c-watts">Watts each</label>
          <input type="number" id="c-watts" class="field" min="1" max="50000" step="any" placeholder="145" style="width: 120px;" />
        </div>
        <div>
          <label for="c-qty">How many (optional)</label>
          <input type="number" id="c-qty" class="field" min="1" max="5000" step="1" placeholder="8" style="width: 120px;" />
        </div>
        <div>
          <label for="c-pf">Power factor</label>
          <input type="number" id="c-pf" class="field" min="0.5" max="1" step="0.01" value="0.9" style="width: 120px;" />
        </div>
      </div>
      <p id="c-note" class="warning" style="display: none;"></p>
      <div id="c-output" class="results patch-results" style="margin-top: 20px; max-width: 760px; display: none;">
        <div class="scroll">
          <table>
            <thead>
              <tr><th>Breaker</th><th>Usable</th><th>Fit on one circuit</th><th>Circuits needed</th><th>Busiest circuit</th></tr>
            </thead>
            <tbody id="c-body"></tbody>
          </table>
        </div>
      </div>
      <p class="hint" style="margin-top: 12px;">Use a power factor of 1.0 for incandescent or tungsten and 0.9&ndash;0.95 for most LED fixtures. If the wattage you entered is already VA, 1.0 is right.</p>
    </section>

    <section class="section">
      <h2>Power estimate</h2>
      <p class="hint">Uses the fixture list from the Patch planner, so enter each fixture&rsquo;s Watts there. Fixtures are packed onto circuits one by one, because a fixture can&rsquo;t be split across two breakers.</p>
      <p class="notice"><strong>Estimate only.</strong> This is not a code-compliance check. Have a qualified electrician verify circuits, wire sizes, breakers and neutral loading before anything is energized.</p>

      <div class="row">
        <div>
          <label for="w-phase">Supply</label>
          <select id="w-phase" class="field">
            <option value="1" selected>120 V single-phase</option>
            <option value="3">208 V 3-phase (120/208 V wye)</option>
          </select>
        </div>
        <div>
          <label for="w-breaker">Circuit breaker</label>
          <select id="w-breaker" class="field">
            <option value="15">15 A</option>
            <option value="20" selected>20 A</option>
            <option value="30">30 A</option>
          </select>
        </div>
        <div>
          <label for="w-pf">Power factor</label>
          <input type="number" id="w-pf" class="field" min="0.5" max="1" step="0.01" value="0.9" style="width: 120px;" />
        </div>
      </div>
      <p class="hint">Circuits are loaded to 80% of the breaker rating (the continuous-load rule), and this can&rsquo;t be changed. Power factor turns watts into volt-amps, which is what the breaker actually sees. Use 1.0 for incandescent or tungsten; LED drivers are often 0.9&ndash;0.95, so check the spec sheet. If your fixture figures are already in VA, a lower power factor only adds safety margin. Everything is on 120 V circuits; 208 V fixtures aren&rsquo;t modelled.</p>

      <div id="w-empty" style="display: none;">
        <p class="summary">Enter Watts for at least one fixture in the Patch planner to see the power estimate.</p>
        <button type="button" id="w-goto" class="btn-secondary">Open Patch planner</button>
      </div>
      <p id="w-warning" class="warning" style="display: none;"></p>

      <div id="w-output">
        <div class="results" style="margin-top: 20px;">
          <table>
            <tbody id="w-totals"></tbody>
          </table>
        </div>

        <div id="w-phase-box" class="results patch-results" style="margin-top: 20px; max-width: 640px;">
          <div class="scroll">
            <table>
              <thead>
                <tr><th>Phase</th><th>Circuits</th><th>Watts</th><th>VA</th><th>Line current</th></tr>
              </thead>
              <tbody id="w-phase-body"></tbody>
            </table>
          </div>
        </div>
        <p id="w-balance" class="summary" style="display: none;"></p>
        <p id="w-three-note" class="warning" style="display: none;">Neutral current here is the fundamental only. LED and other switch-mode supplies add third-harmonic current that stacks up in the neutral, so the real neutral current can be as high as the phase current, or higher. Don&rsquo;t size the neutral from this number.</p>

        <div class="results patch-results" style="margin-top: 20px;">
          <div class="scroll">
            <table class="stack">
              <thead class="stack-head">
                <tr><th>Circuit</th><th id="w-zone-th">Zone</th><th>Load</th><th>Current</th><th>Of usable</th><th>On this circuit</th></tr>
              </thead>
              <tbody id="w-body"></tbody>
            </table>
          </div>
        </div>
        <p class="hint" style="margin-top: 12px;">The circuit count assumes 120 V single-pole circuits, filled largest fixture first. Inrush current when many fixtures switch on together isn&rsquo;t modelled, and some LED supplies can trip a breaker at power-up. Treat the circuit count as a minimum.</p>
      </div>
    </section>
  </div>

  <Footer />
</Layout>

<style>
  .section {
    margin: 48px 0;
  }
  h2 {
    font-size: 20px;
    margin: 0 0 6px;
  }
  .hint {
    margin: 0 0 20px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-dim);
    max-width: 640px;
  }
  code {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }
  .row {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: flex-end;
    margin-bottom: 24px;
  }
  label {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 8px;
  }
  :global(.field) {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 10px 14px;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 14px;
    max-width: 100%;
    height: 40px;
  }
  :global(.field:focus-visible),
  .dip-switch:focus-visible,
  .tab:focus-visible,
  :global(.icon-btn:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* DIP switch bank: modelled on the red blocks found on fixture rear panels */
  .dip {
    position: relative;
    max-width: 520px;
    background: #1f4c9e;
    border-radius: 6px;
    padding: 30px 16px 10px;
    box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.25);
  }
  .dip-on {
    position: absolute;
    top: 8px;
    left: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #e6edf8;
  }
  .dip-switches {
    display: flex;
    gap: 8px;
  }
  .dip-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .dip-switch {
    width: 100%;
    max-width: 38px;
    height: 72px;
    padding: 4px;
    border: none;
    border-radius: 3px;
    background: #0b1a36;
    cursor: pointer;
    display: flex;
    align-items: flex-end;
  }
  .dip-switch[aria-pressed='true'] {
    align-items: flex-start;
  }
  .dip-knob {
    display: block;
    width: 100%;
    height: 30px;
    border-radius: 2px;
    background: #f3eee8;
    box-shadow: inset 0 -2px 0 #c9c1b8;
    transition: transform 0.08s ease;
  }
  .dip-switch:active .dip-knob {
    transform: scale(0.94);
  }
  .dip-num {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: #e6edf8;
  }
  .dip-weights {
    display: flex;
    gap: 8px;
    max-width: 520px;
    padding: 8px 16px 0;
  }
  .dip-weights span {
    flex: 1;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
  }

  .summary {
    margin: 20px 0 0;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-muted);
  }
  .warning {
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: #e0b374;
    max-width: 640px;
  }

  .results {
    max-width: 560px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  tr {
    border-bottom: 1px solid var(--border);
  }
  tr:last-child {
    border-bottom: none;
  }
  td {
    padding: 14px 20px;
  }
  td:first-child {
    color: var(--text-faint);
  }
  td:last-child {
    color: var(--text);
    text-align: right;
    font-weight: 700;
  }


  /* Tabs */
  .tabs {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 24px 0 8px;
  }
  .tab {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 18px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
    cursor: pointer;
  }
  .tab[aria-selected='true'] {
    background: var(--bg-card);
    border-color: var(--accent);
    color: var(--accent);
  }
  .section:first-child {
    margin-top: 32px;
  }

  /* Patch planner */
  .fixture-head,
  #fixture-list :global(.fixture-row) {
    display: grid;
    grid-template-columns: minmax(130px, 1fr) 100px 90px 80px 110px 150px 40px;
    gap: 12px;
    align-items: center;
    max-width: 1000px;
  }
  .fixture-head {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 8px;
  }
  #fixture-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  #fixture-list :global(.field) {
    width: 100%;
  }
  #fixture-list :global(.icon-btn) {
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-dim);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }
  #fixture-list :global(.icon-btn:hover) {
    color: var(--text);
    border-color: var(--text-faint);
  }
  .btn-primary {
    background: var(--accent);
    border: none;
    color: #0d0d0f;
    padding: 10px 20px;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
  }
  .btn-secondary {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-dim);
    padding: 10px 20px;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    cursor: pointer;
  }
  .patch-results {
    max-width: none;
  }
  .scroll {
    overflow-x: auto;
  }
  .patch-results th {
    text-align: left;
    padding: 12px 20px;
    font-weight: 500;
    font-size: 12px;
    color: var(--text-faint);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  #p-body :global(tr),
  #c-body :global(tr),
  #p-ubody :global(tr),
  #w-body :global(tr),
  #w-phase-body :global(tr) {
    border-bottom: 1px solid var(--border);
  }
  #p-body :global(tr:last-child),
  #c-body :global(tr:last-child),
  #p-ubody :global(tr:last-child),
  #w-body :global(tr:last-child),
  #w-phase-body :global(tr:last-child) {
    border-bottom: none;
  }
  #p-body :global(td),
  #c-body :global(td),
  #p-ubody :global(td),
  #w-body :global(td),
  #w-phase-body :global(td) {
    padding: 10px 20px;
    text-align: left;
    font-weight: 400;
    color: var(--text-muted);
    white-space: nowrap;
  }
  #p-body :global(td:first-child),
  #c-body :global(td:first-child),
  #p-ubody :global(td:first-child),
  #w-body :global(td:first-child),
  #w-phase-body :global(td:first-child) {
    color: var(--text);
  }
  #p-body :global(td.addr),
  #w-body :global(td.addr),
  #w-phase-body :global(td.addr) {
    color: var(--text);
    font-weight: 700;
  }
  #p-body :global(tr.universe-start td),
  #w-body :global(tr.universe-start td),
  #w-phase-body :global(tr.universe-start td) {
    border-top: 1px solid var(--text-faint);
  }

  #w-totals :global(tr) {
    border-bottom: 1px solid var(--border);
  }
  #w-totals :global(tr:last-child) {
    border-bottom: none;
  }
  #w-totals :global(td) {
    padding: 14px 20px;
  }
  #w-totals :global(td:first-child) {
    color: var(--text-faint);
  }
  #w-totals :global(td:last-child) {
    color: var(--text);
    text-align: right;
    font-weight: 700;
  }
  .notice {
    margin: 0 0 20px;
    padding: 12px 16px;
    max-width: 640px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-muted);
    border: 1px solid #e0b374;
    border-radius: 8px;
  }
  #c-body :global(td.addr) {
    color: var(--text);
    font-weight: 700;
  }
  #c-body :global(td.over) {
    color: #e0b374;
    font-weight: 700;
    white-space: normal;
  }
  #w-body :global(td.over) {
    color: #e0b374;
    font-weight: 700;
  }
  #p-ubody :global(td.contents) {
    white-space: normal;
    min-width: 200px;
  }
  #p-ubody :global(td.full) {
    color: #e0b374;
    font-weight: 700;
  }
  #w-body :global(td.contents) {
    white-space: normal;
    min-width: 200px;
  }
  #fixture-list :global(.num-label) {
    display: block;
    margin: 0;
  }
  #fixture-list :global(.num-label span) {
    display: none;
  }

  @media (max-width: 560px) {
    /* column headers stay for screen readers while rows are shown as cards */
    .stack-head {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    table.stack,
    table.stack tbody {
      display: block;
      width: 100%;
    }
    #p-ubody :global(tr),
    #w-body :global(tr) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px 16px;
      padding: 12px 16px;
    }
    #p-ubody :global(td),
    #w-body :global(td) {
      display: block;
      padding: 0;
      min-width: 0;
      white-space: normal;
      overflow-wrap: anywhere;
    }
    #p-ubody :global(td::before),
    #w-body :global(td::before) {
      content: attr(data-label);
      display: block;
      font-size: 11px;
      color: var(--text-dim);
      margin-bottom: 2px;
    }
    /* the first cell is the card title: "Universe 2", "Circuit 3" */
    #p-ubody :global(td:first-child),
    #w-body :global(td:first-child) {
      grid-column: 1 / -1;
    }
    #p-ubody :global(td:first-child::before),
    #w-body :global(td:first-child::before) {
      content: attr(data-label) ' ';
      display: inline;
      font-size: inherit;
      color: inherit;
      margin: 0;
    }
    #p-ubody :global(td.contents),
    #w-body :global(td.contents),
    #w-body :global(td[data-label='Zone']),
    #w-body :global(td[data-label='Load']) {
      grid-column: 1 / -1;
    }
    /* two rows per fixture: name + remove, then channels / watts / qty with small labels */
    .fixture-head {
      display: none;
    }
    #fixture-list :global(.fixture-row) {
      grid-template-columns: repeat(3, minmax(0, 1fr)) 40px;
      gap: 8px;
      padding: 10px 0;
      border-bottom: 1px solid var(--border);
    }
    #fixture-list :global(.fixture-row > :nth-child(1)) {
      grid-column: 1 / 4;
    }
    #fixture-list :global(.fixture-row > :nth-child(5)) {
      grid-column: 1;
    }
    #fixture-list :global(.fixture-row > :nth-child(6)) {
      grid-column: 2 / 5;
    }
    #fixture-list :global(.fixture-row > :nth-child(7)) {
      grid-column: 4;
      grid-row: 1;
    }
    #fixture-list :global(.num-label span) {
      display: block;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-faint);
      margin-bottom: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dip-knob {
      transition: none;
    }
  }
</style>

<script>
  // ---------- DIP switches ----------
  const addrInput = document.getElementById('addr-input') as HTMLInputElement;
  const footprintInput = document.getElementById('footprint-input') as HTMLInputElement;
  const modeSelect = document.getElementById('mode-select') as HTMLSelectElement;
  const dipSummary = document.getElementById('dip-summary') as HTMLParagraphElement;
  const dipWarning = document.getElementById('dip-warning') as HTMLParagraphElement;
  const switchEls = Array.from(document.querySelectorAll<HTMLButtonElement>('.dip-switch'));

  const isOn = (el: HTMLButtonElement) => el.getAttribute('aria-pressed') === 'true';
  const setOn = (el: HTMLButtonElement, on: boolean) => el.setAttribute('aria-pressed', String(on));
  const offset = () => (modeSelect.value === 'plus1' ? 1 : 0);

  function switchTotal(): number {
    return switchEls.slice(0, 9).reduce((sum, el, i) => sum + (isOn(el) ? 2 ** i : 0), 0);
  }

  function updateDipText() {
    const address = switchTotal() + offset();
    const footprint = Math.max(1, Math.floor(Number(footprintInput.value)) || 1);
    const onList = switchEls.slice(0, 9).filter(isOn).map((el) => el.dataset.n);

    const warnings: string[] = [];
    if (address === 0) {
      warnings.push('All address switches off gives address 0, which isn\u2019t a valid DMX address. Most fixtures treat it as 1.');
    }
    const last = address + footprint - 1;
    if (address > 0 && last > 512) {
      warnings.push(`A ${footprint}-channel fixture at ${address} would run to channel ${last}, past the end of the universe (512). Move it to ${513 - footprint} or lower, or to the next universe.`);
    }

    dipSummary.textContent =
      address === 0
        ? 'No address switches on.'
        : `Address ${address}` +
          (footprint > 1 ? `, using channels ${address}\u2013${Math.min(last, 512)}` : '') +
          `. Switches on: ${onList.length ? onList.join(', ') : 'none'}.`;

    dipWarning.textContent = warnings.join(' ');
    dipWarning.style.display = warnings.length ? 'block' : 'none';
  }

  function setSwitchesFromAddress() {
    const address = Math.floor(Number(addrInput.value));
    const total = address - offset();
    if (!Number.isFinite(address) || address < 1 || address > 512) {
      dipWarning.textContent = 'Enter an address from 1 to 512.';
      dipWarning.style.display = 'block';
      return;
    }
    if (total > 511) {
      dipWarning.textContent = 'Nine switches only reach 511. Address 512 needs a fixture that uses the \u201cswitch total + 1\u201d convention.';
      dipWarning.style.display = 'block';
      return;
    }
    switchEls.slice(0, 9).forEach((el, i) => setOn(el, ((total >> i) & 1) === 1));
    updateDipText();
  }

  switchEls.forEach((el, i) => {
    el.addEventListener('click', () => {
      setOn(el, !isOn(el));
      if (i < 9) {
        const address = switchTotal() + offset();
        addrInput.value = address === 0 ? '' : String(address);
      }
      updateDipText();
    });
  });

  addrInput.addEventListener('input', setSwitchesFromAddress);
  footprintInput.addEventListener('input', updateDipText);
  // Changing the convention keeps the typed address and re-derives the switches.
  modeSelect.addEventListener('change', setSwitchesFromAddress);

  setSwitchesFromAddress();

  // ---------- Universe conversion ----------
  const uInput = document.getElementById('u-input') as HTMLInputElement;
  const uBase = document.getElementById('u-base') as HTMLSelectElement;
  const uError = document.getElementById('u-error') as HTMLParagraphElement;
  const uResults = document.getElementById('u-results') as HTMLDivElement;
  const cell = (id: string) => document.getElementById(id) as HTMLTableCellElement;

  const MAX_SACN = 63999;
  const MAX_ARTNET = 32767;

  function showUError(msg: string) {
    uError.textContent = msg;
    uError.style.display = 'block';
    uResults.style.display = 'none';
  }

  function convertUniverse() {
    const raw = uInput.value.trim();
    let universe: number; // always 1-based internally
    let address: number;

    const split = raw.match(/^(\d+)\s*[.\/:]\s*(\d+)$/);
    if (split) {
      universe = Number(split[1]) + (uBase.value === '0' ? 1 : 0);
      address = Number(split[2]);
      if (address < 1 || address > 512) return showUError('The address part must be from 1 to 512.');
      if (universe < 1) return showUError('Universe must be 1 or higher when numbering starts at 1.');
    } else if (/^\d+$/.test(raw)) {
      const absolute = Number(raw);
      if (absolute < 1) return showUError('Absolute addresses start at 1.');
      universe = Math.floor((absolute - 1) / 512) + 1;
      address = ((absolute - 1) % 512) + 1;
    } else {
      return showUError('Enter a number like 557, or a universe and address like 2.45 or 2/45.');
    }

    if (universe > MAX_SACN) return showUError(`That\u2019s past the highest sACN universe (${MAX_SACN.toLocaleString()}).`);

    uError.style.display = 'none';
    uResults.style.display = 'block';

    const absolute = (universe - 1) * 512 + address;
    const start = (universe - 1) * 512 + 1;
    const port = universe - 1;

    cell('u-console').textContent = `${universe} / ${address}  (${universe}.${String(address).padStart(3, '0')})`;
    cell('u-absolute').textContent = absolute.toLocaleString();
    cell('u-range').textContent = `${start.toLocaleString()}\u2013${(start + 511).toLocaleString()}`;
    cell('u-sacn').textContent = String(universe);
    cell('u-mcast').textContent = `239.255.${universe >> 8}.${universe & 0xff}`;
    if (port > MAX_ARTNET) {
      cell('u-artnet').textContent = 'Out of range';
      cell('u-artnet-split').textContent = '\u2014';
    } else {
      cell('u-artnet').textContent = String(port);
      cell('u-artnet-split').textContent = `${(port >> 8) & 0x7f} / ${(port >> 4) & 0xf} / ${port & 0xf}`;
    }
  }

  uInput.addEventListener('input', convertUniverse);
  uBase.addEventListener('change', convertUniverse);
  convertUniverse();

  // ---------- Tabs ----------
  const tabs = [
    { btn: document.getElementById('tab-addressing') as HTMLButtonElement, panel: document.getElementById('panel-addressing') as HTMLDivElement, hash: '' },
    { btn: document.getElementById('tab-patch') as HTMLButtonElement, panel: document.getElementById('panel-patch') as HTMLDivElement, hash: '#patch' },
    { btn: document.getElementById('tab-power') as HTMLButtonElement, panel: document.getElementById('panel-power') as HTMLDivElement, hash: '#power' }
  ];

  function showTab(index: number, updateHash = true) {
    tabs.forEach((t, i) => {
      t.btn.setAttribute('aria-selected', String(i === index));
      t.panel.hidden = i !== index;
    });
    if (updateHash) history.replaceState(null, '', tabs[index].hash || location.pathname);
  }

  tabs.forEach((t, i) => t.btn.addEventListener('click', () => showTab(i)));
  showTab(location.hash === '#patch' ? 1 : location.hash === '#power' ? 2 : 0, false);

  // ---------- Patch planner ----------
  type Fixture = { name: string; channels: number; qty: number; watts: number; start: string; zone: string };

  const STORAGE_KEY = 'bluejay-patch-v1';
  const EXAMPLE: Fixture[] = [
    { name: 'Moving head', channels: 16, qty: 8, watts: 350, start: '', zone: '' },
    { name: 'LED par', channels: 7, qty: 24, watts: 80, start: '', zone: '' },
    { name: 'LED batten', channels: 36, qty: 7, watts: 120, start: '', zone: '' }
  ];

  const fixtureList = document.getElementById('fixture-list') as HTMLDivElement;
  const pStartU = document.getElementById('p-start-universe') as HTMLInputElement;
  const pStartA = document.getElementById('p-start-address') as HTMLInputElement;
  const pSplit = document.getElementById('p-split') as HTMLSelectElement;
  const pSummary = document.getElementById('p-summary') as HTMLParagraphElement;
  const pWarning = document.getElementById('p-warning') as HTMLParagraphElement;
  const pOutput = document.getElementById('p-output') as HTMLDivElement;
  const pBody = document.getElementById('p-body') as HTMLTableSectionElement;
  const pUniverses = document.getElementById('p-universes') as HTMLDivElement;
  const pUBody = document.getElementById('p-ubody') as HTMLTableSectionElement;

  // power tab controls (read by loadFixtures, so declared first)
  const wPhase = document.getElementById('w-phase') as HTMLSelectElement;
  const wBreaker = document.getElementById('w-breaker') as HTMLSelectElement;
  const wPf = document.getElementById('w-pf') as HTMLInputElement;

  let fixtures: Fixture[] = loadFixtures();

  function loadFixtures(): Fixture[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed.fixtures)) {
          pStartU.value = String(parsed.startUniverse ?? 1);
          pStartA.value = String(parsed.startAddress ?? 1);
          pSplit.value = parsed.split === 'yes' ? 'yes' : 'no';
          const p = parsed.power;
          if (p && typeof p === 'object') {
            if (p.phase === '1' || p.phase === '3') wPhase.value = p.phase;
            if (['15', '20', '30'].includes(String(p.breaker))) wBreaker.value = String(p.breaker);
            if (Number(p.pf) >= 0.5 && Number(p.pf) <= 1) wPf.value = String(p.pf);
          }
          // saved lists from before the Power tab have no watts; treat them as not entered yet
          return parsed.fixtures.map((f: Partial<Fixture>) => ({
            name: typeof f.name === 'string' ? f.name : '',
            channels: Number(f.channels),
            qty: Number(f.qty),
            watts: Number(f.watts) > 0 ? Number(f.watts) : 0,
            // lists saved before per-group starts have none; blank means continue from the previous group
            start: typeof f.start === 'string' ? f.start : '',
            zone: typeof f.zone === 'string' ? f.zone : ''
          }));
        }
      }
    } catch {
      /* storage unavailable or corrupt: fall back to the example */
    }
    return EXAMPLE.map((f) => ({ ...f }));
  }

  function saveFixtures() {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          fixtures,
          startUniverse: pStartU.value,
          startAddress: pStartA.value,
          split: pSplit.value,
          power: { phase: wPhase.value, breaker: wBreaker.value, pf: wPf.value }
        })
      );
    } catch {
      /* private browsing or storage full: the planner still works, it just won't persist */
    }
  }

  type NumberRange = { min: string; max: string; step?: string; short: string };

  function makeInput(type: string, value: string, label: string, onInput: (v: string) => void, range?: NumberRange) {
    const input = document.createElement('input');
    input.type = type;
    input.className = 'field';
    input.value = value;
    input.setAttribute('aria-label', label);
    if (type === 'number') {
      input.min = range?.min ?? '1';
      input.max = range?.max ?? '512';
      if (range?.step) input.step = range.step;
    } else {
      input.autocomplete = 'off';
      input.spellcheck = false;
    }
    input.addEventListener('input', () => onInput(input.value));
    if (type !== 'number' || !range) return input;
    // number fields get a small label that only shows on phones, where the column headers are hidden
    const wrap = document.createElement('label');
    wrap.className = 'num-label';
    const cap = document.createElement('span');
    cap.textContent = range.short;
    cap.setAttribute('aria-hidden', 'true');
    wrap.append(cap, input);
    return wrap;
  }

  // optional "universe.address" start for a fixture group, with the same small phone-only caption as the number fields
  function makeStartInput(f: Fixture, n: number) {
    const input = makeInput('text', f.start, `Fixture ${n} start, universe and address such as 5.1 (optional)`, (v) => { f.start = v; recalc(); }) as HTMLInputElement;
    input.placeholder = 'auto';
    input.maxLength = 12;
    input.inputMode = 'decimal';
    const wrap = document.createElement('label');
    wrap.className = 'num-label';
    const cap = document.createElement('span');
    cap.textContent = 'Start (optional)';
    cap.setAttribute('aria-hidden', 'true');
    wrap.append(cap, input);
    return wrap;
  }

  // optional power zone for a fixture group; the Power tab keeps different zones on separate circuits
  function makeZoneInput(f: Fixture, n: number) {
    const input = makeInput('text', f.zone, `Fixture ${n} power zone, for example Catwalk 1 (optional)`, (v) => { f.zone = v; recalc(); }) as HTMLInputElement;
    input.placeholder = 'none';
    input.maxLength = 40;
    input.setAttribute('list', 'zone-list');
    const wrap = document.createElement('label');
    wrap.className = 'num-label';
    const cap = document.createElement('span');
    cap.textContent = 'Zone (optional)';
    cap.setAttribute('aria-hidden', 'true');
    wrap.append(cap, input);
    return wrap;
  }

  // "5", "5.1", "5/1" or "5:1" -> universe and address; blank means continue from the previous group
  function parseStart(raw: string): { u: number; a: number } | null | 'bad' {
    const s = raw.trim();
    if (!s) return null;
    const m = /^(\d{1,5})(?:\s*[./:]\s*(\d{1,3}))?$/.exec(s);
    if (!m) return 'bad';
    const u = Number(m[1]);
    const a = m[2] === undefined ? 1 : Number(m[2]);
    if (u < 1 || u > 63999 || a < 1 || a > 512) return 'bad';
    return { u, a };
  }

  function renderFixtureRows() {
    fixtureList.innerHTML = '';
    fixtures.forEach((f, i) => {
      const row = document.createElement('div');
      row.className = 'fixture-row';
      const n = i + 1;
      row.append(
        makeInput('text', f.name, `Fixture ${n} name`, (v) => { f.name = v; recalc(); }),
        makeInput('number', String(f.channels), `Fixture ${n} channels`, (v) => { f.channels = Math.floor(Number(v)); recalc(); }, { min: '1', max: '512', short: 'Channels' }),
        makeInput('number', f.watts > 0 ? String(f.watts) : '', `Fixture ${n} watts each`, (v) => { f.watts = Number(v) > 0 ? Number(v) : 0; recalc(); }, { min: '0', max: '50000', step: 'any', short: 'Watts' }),
        makeInput('number', String(f.qty), `Fixture ${n} quantity`, (v) => { f.qty = Math.floor(Number(v)); recalc(); }, { min: '1', max: '2000', short: 'Qty' }),
        makeStartInput(f, n),
        makeZoneInput(f, n)
      );
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'icon-btn';
      remove.textContent = '\u00d7';
      remove.setAttribute('aria-label', `Remove ${f.name || `fixture ${n}`}`);
      remove.addEventListener('click', () => {
        fixtures.splice(i, 1);
        renderFixtureRows();
        recalc();
      });
      row.append(remove);
      fixtureList.appendChild(row);
    });
  }

  type Patched = { label: string; group: string; zone: string; universe: number; address: number; end: number; endUniverse: number; channels: number; watts: number };

  function dipOn(address: number): string {
    const total = address - offset();
    if (total < 0 || total > 511) return '\u2014';
    const on: number[] = [];
    for (let i = 0; i < 9; i++) if ((total >> i) & 1) on.push(i + 1);
    return on.length ? on.join(', ') : 'none';
  }

  let lastPatch: Patched[] = [];

  const zoneList = document.getElementById('zone-list') as HTMLDataListElement;

  // copies each column header onto its cells, so the phone layout can caption them (hidden columns are skipped)
  function labelCells(body: HTMLTableSectionElement) {
    const head = body.closest('table')?.tHead?.rows[0];
    const names = head ? [...head.cells].filter((th) => th.style.display !== 'none').map((th) => th.textContent ?? '') : [];
    body.querySelectorAll('tr').forEach((tr) => {
      [...tr.children].forEach((td, i) => ((td as HTMLElement).dataset.label = names[i] ?? ''));
    });
  }

  function recalc() {
    saveFixtures();
    zoneList.innerHTML = '';
    const seenZones = new Set<string>();
    for (const z of fixtures.map((f) => f.zone.trim()).filter(Boolean)) {
      if (seenZones.has(z.toLowerCase())) continue;
      seenZones.add(z.toLowerCase());
      const o = document.createElement('option');
      o.value = z;
      zoneList.appendChild(o);
    }
    const warnings: string[] = [];
    let universe = Math.max(1, Math.floor(Number(pStartU.value)) || 1);
    let address = Math.min(512, Math.max(1, Math.floor(Number(pStartA.value)) || 1));
    const allowSplit = pSplit.value === 'yes';
    let used = 0;
    let wasted = 0;
    const out: Patched[] = [];
    // which channels are taken in each universe, and by which fixture group, to flag two groups sharing channels
    const taken = new Map<number, Uint8Array>();
    const owner = new Map<number, string[]>();
    const overlaps = new Set<string>();
    const contents = new Map<number, Map<string, number>>();

    for (const f of fixtures) {
      const ch = f.channels;
      const qty = f.qty;
      const name = f.name.trim() || 'Fixture';
      if (!Number.isInteger(ch) || ch < 1 || ch > 512) {
        warnings.push(`${name}: channels must be 1\u2013512.`);
        continue;
      }
      if (!Number.isInteger(qty) || qty < 1) {
        warnings.push(`${name}: quantity must be at least 1.`);
        continue;
      }
      if (qty > 2000) {
        warnings.push(`${name}: quantity capped at 2,000.`);
      }
      const start = parseStart(f.start);
      if (start === 'bad') {
        warnings.push(`${name}: start \u201c${f.start.trim()}\u201d isn\u2019t a universe and address like 5.1, so it continues after the previous group.`);
      } else if (start) {
        universe = start.u;
        address = start.a;
      }
      for (let n = 1; n <= Math.min(qty, 2000); n++) {
        if (!allowSplit && address + ch - 1 > 512) {
          if (n === 1 && start && start !== 'bad') {
            warnings.push(`${name} doesn\u2019t fit at ${start.u}.${start.a}, so it starts at ${universe + 1}.1.`);
          } else {
            wasted += 513 - address;
          }
          universe++;
          address = 1;
        }
        const startU = universe;
        const startA = address;
        const absEnd = (universe - 1) * 512 + address + ch - 1;
        const endU = Math.floor((absEnd - 1) / 512) + 1;
        const endA = ((absEnd - 1) % 512) + 1;
        out.push({ label: qty > 1 ? `${name} ${n}` : name, group: name, zone: f.zone.trim(), universe: startU, address: startA, end: endA, endUniverse: endU, channels: ch, watts: f.watts });
        used += ch;
        // mark each channel this fixture takes
        for (let c = (startU - 1) * 512 + startA; c <= absEnd; c++) {
          const cu = Math.floor((c - 1) / 512) + 1;
          const ca = ((c - 1) % 512) + 1;
          let slots = taken.get(cu);
          let who = owner.get(cu);
          if (!slots || !who) {
            slots = new Uint8Array(513);
            who = new Array<string>(513).fill('');
            taken.set(cu, slots);
            owner.set(cu, who);
          }
          if (slots[ca] && who[ca] !== name) overlaps.add(`${who[ca]}|${name}|${cu}`);
          slots[ca] = 1;
          who[ca] = name;
        }
        let inU = contents.get(startU);
        if (!inU) {
          inU = new Map<string, number>();
          contents.set(startU, inU);
        }
        inU.set(name, (inU.get(name) ?? 0) + 1);
        universe = endA === 512 ? endU + 1 : endU;
        address = endA === 512 ? 1 : endA + 1;
      }
    }

    lastPatch = out;
    pBody.innerHTML = '';
    let prevU = -1;
    for (const p of out) {
      const tr = document.createElement('tr');
      if (prevU !== -1 && p.universe !== prevU) tr.className = 'universe-start';
      prevU = p.universe;
      const range = p.endUniverse === p.universe ? `${p.address}\u2013${p.end}` : `${p.address}\u2013${p.endUniverse}.${p.end}`;
      const cells: [string, string?][] = [
        [p.label],
        [String(p.universe)],
        [String(p.address), 'addr'],
        [p.channels === 1 ? String(p.address) : range],
        [`${p.universe}.${String(p.address).padStart(3, '0')}`],
        [dipOn(p.address)]
      ];
      for (const [text, cls] of cells) {
        const td = document.createElement('td');
        td.textContent = text;
        if (cls) td.className = cls;
        tr.appendChild(td);
      }
      pBody.appendChild(tr);
    }

    const universes = taken.size;
    for (const key of overlaps) {
      const [a, b, u] = key.split('|');
      warnings.push(`${a} and ${b} overlap in universe ${u}: the same channels are patched twice.`);
    }
    // one row per universe in use: how full it is and which groups are in it
    pUBody.innerHTML = '';
    for (const u of [...taken.keys()].sort((x, y) => x - y)) {
      const slots = taken.get(u) as Uint8Array;
      let count = 0;
      for (let a = 1; a <= 512; a++) if (slots[a]) count++;
      const tr = document.createElement('tr');
      const groups = [...(contents.get(u) ?? new Map<string, number>())].map(([g, k]) => (k > 1 ? `${g} \u00d7${k}` : g));
      const cells: [string, string?][] = [
        [String(u), 'addr'],
        [`${count} / 512`, count === 512 ? 'full' : undefined],
        [String(512 - count)],
        [groups.join(', ') || '(continued from the previous universe)', 'contents']
      ];
      for (const [text, cls] of cells) {
        const td = document.createElement('td');
        td.textContent = text;
        if (cls) td.className = cls;
        tr.appendChild(td);
      }
      pUBody.appendChild(tr);
    }
    labelCells(pUBody);
    pUniverses.style.display = out.length ? 'block' : 'none';
    pOutput.style.display = out.length ? 'block' : 'none';
    pSummary.textContent = out.length
      ? `${out.length} fixture${out.length === 1 ? '' : 's'}, ${used.toLocaleString()} channels across ${universes} universe${universes === 1 ? '' : 's'}` +
        (wasted ? `, ${wasted} channel${wasted === 1 ? '' : 's'} left unused at universe ends.` : '.')
      : 'Add a fixture to start the patch.';
    if (allowSplit && out.some((p) => p.endUniverse !== p.universe)) {
      warnings.push('Some fixtures cross a universe boundary. Most fixtures can\u2019t do this; switch to \u201cNever split\u201d unless yours can.');
    }
    pWarning.textContent = warnings.join(' ');
    pWarning.style.display = warnings.length ? 'block' : 'none';
    recalcPower();
  }

  function csvCell(v: string | number) {
    const s = String(v);
    // Neutralise spreadsheet formulas: a text cell starting with = + - @ (or tab/CR)
    // is evaluated by Excel/Sheets, so prefix it with an apostrophe.
    const safe = typeof v === 'string' && /^[=+\-@\t\r]/.test(s) ? `'${s}` : s;
    return /[",\n\r]/.test(safe) ? `"${safe.replace(/"/g, '""')}"` : safe;
  }


  // ---------- Power ----------
  const wOutput = document.getElementById('w-output') as HTMLDivElement;
  const wEmpty = document.getElementById('w-empty') as HTMLDivElement;
  const wWarning = document.getElementById('w-warning') as HTMLParagraphElement;
  const wTotals = document.getElementById('w-totals') as HTMLTableSectionElement;
  const wPhaseBox = document.getElementById('w-phase-box') as HTMLDivElement;
  const wPhaseBody = document.getElementById('w-phase-body') as HTMLTableSectionElement;
  const wBalance = document.getElementById('w-balance') as HTMLParagraphElement;
  const wThreeNote = document.getElementById('w-three-note') as HTMLParagraphElement;
  const wBody = document.getElementById('w-body') as HTMLTableSectionElement;
  const wZoneTh = document.getElementById('w-zone-th') as HTMLTableCellElement;

  const LEG_VOLTS = 120; // every circuit is 120 V single-pole
  const LINE_VOLTS = 208; // 120/208 V wye
  const USABLE_FRACTION = 0.8; // continuous-load rule; deliberately not adjustable
  const MAX_UNITS = 5000;

  const fmt = (n: number, digits = 0) => n.toLocaleString(undefined, { minimumFractionDigits: digits, maximumFractionDigits: digits });

  type Circuit = { va: number; w: number; counts: Map<string, number>; phase: number; zone: string; zi: number };

  function addRow(body: HTMLTableSectionElement, cells: [string, string?][]) {
    const tr = document.createElement('tr');
    for (const [text, cls] of cells) {
      const td = document.createElement('td');
      td.textContent = text;
      if (cls) td.className = cls;
      tr.appendChild(td);
    }
    body.appendChild(tr);
  }

  function recalcPower() {
    const threePhase = wPhase.value === '3';
    const breaker = ['15', '20', '30'].includes(wBreaker.value) ? Number(wBreaker.value) : 20;
    const warnings: string[] = [];
    let pf = Number(wPf.value);
    if (!(pf >= 0.5 && pf <= 1)) {
      warnings.push('Power factor must be between 0.5 and 1.0, so 0.9 is being used.');
      pf = 0.9;
    }
    const capVA = LEG_VOLTS * breaker * USABLE_FRACTION;

    // one entry per physical fixture
    const units: { name: string; w: number; va: number; zone: string }[] = [];
    const noWatts: string[] = [];
    let capped = false;
    for (const f of fixtures) {
      const name = f.name.trim() || 'Fixture';
      if (!Number.isInteger(f.qty) || f.qty < 1) continue; // the patch planner already flags this
      if (!(f.watts > 0)) {
        noWatts.push(name);
        continue;
      }
      for (let n = 0; n < f.qty; n++) {
        if (units.length >= MAX_UNITS) {
          capped = true;
          break;
        }
        units.push({ name, w: f.watts, va: f.watts / pf, zone: f.zone.trim() });
      }
    }
    if (noWatts.length) {
      const one = noWatts.length === 1;
      warnings.push(`No wattage entered for ${noWatts.join(', ')}, so ${one ? 'it isn\u2019t' : 'they aren\u2019t'} counted${units.length ? `. The totals below are too low until you add ${one ? 'it' : 'them'}.` : '.'}`);
    }
    if (capped) warnings.push(`Only the first ${MAX_UNITS.toLocaleString()} fixtures are counted.`);

    wWarning.style.display = 'none';
    wBody.innerHTML = '';
    wTotals.innerHTML = '';
    wPhaseBody.innerHTML = '';

    if (!units.length) {
      wOutput.style.display = 'none';
      wEmpty.style.display = 'block';
      if (warnings.length) {
        wWarning.textContent = warnings.join(' ');
        wWarning.style.display = 'block';
      }
      return;
    }
    wEmpty.style.display = 'none';
    wOutput.style.display = 'block';

    // first-fit decreasing within each zone: biggest fixtures first, each onto the first circuit in its zone with room.
    // Fixtures in different zones never share a circuit; fixtures with no zone are packed together.
    const byZone = new Map<string, typeof units>();
    for (const u of units) {
      const key = u.zone.toLowerCase();
      const list = byZone.get(key);
      if (list) list.push(u);
      else byZone.set(key, [u]);
    }
    const circuits: Circuit[] = [];
    let oversize = 0;
    let zi = 0;
    for (const list of byZone.values()) {
      const zoneName = list[0].zone; // as first typed, before sorting
      list.sort((a, b) => b.va - a.va);
      const zoneCircuits: Circuit[] = [];
      for (const u of list) {
        let c: Circuit | undefined;
        if (u.va <= capVA) c = zoneCircuits.find((x) => x.va + u.va <= capVA + 1e-9);
        else oversize++;
        if (!c) {
          c = { va: 0, w: 0, counts: new Map(), phase: 0, zone: zoneName, zi };
          zoneCircuits.push(c);
        }
        c.va += u.va;
        c.w += u.w;
        c.counts.set(u.name, (c.counts.get(u.name) ?? 0) + 1);
      }
      circuits.push(...zoneCircuits);
      zi++;
    }
    if (oversize) {
      warnings.push(`${oversize} fixture${oversize === 1 ? '' : 's'} draw${oversize === 1 ? 's' : ''} more than one ${breaker} A circuit can carry (${fmt(capVA)} VA usable). Each sits alone on an overloaded circuit below; use a bigger circuit or a different supply for ${oversize === 1 ? 'it' : 'them'}.`);
    }

    const totalW = units.reduce((s, u) => s + u.w, 0);
    const totalVA = units.reduce((s, u) => s + u.va, 0);

    // 3-phase: give each circuit, largest first, to whichever phase is lightest so far
    const phaseVA = [0, 0, 0];
    const phaseW = [0, 0, 0];
    const phaseCount = [0, 0, 0];
    if (threePhase) {
      for (const c of [...circuits].sort((a, b) => b.va - a.va)) {
        const lightest = phaseVA.indexOf(Math.min(...phaseVA));
        c.phase = lightest;
        phaseVA[lightest] += c.va;
        phaseW[lightest] += c.w;
        phaseCount[lightest]++;
      }
      circuits.sort((a, b) => a.phase - b.phase || a.zi - b.zi || b.va - a.va);
    }

    addRow(wTotals, [['Real power', ''], [`${fmt(totalW)} W`]]);
    addRow(wTotals, [[`Apparent power (at PF ${pf})`], [`${fmt(totalVA)} VA`]]);
    if (threePhase) {
      addRow(wTotals, [['Line current if perfectly balanced (208 V)'], [`${fmt(totalVA / (Math.sqrt(3) * LINE_VOLTS), 1)} A`]]);
      const [a, b, c] = phaseVA.map((v) => v / LEG_VOLTS);
      const neutral = Math.sqrt(Math.max(0, a * a + b * b + c * c - a * b - b * c - c * a));
      addRow(wTotals, [['Neutral current (fundamental only)'], [`${fmt(neutral, 1)} A`]]);
    } else {
      addRow(wTotals, [['Current at 120 V'], [`${fmt(totalVA / LEG_VOLTS, 1)} A`]]);
    }
    addRow(wTotals, [[`Circuits needed (${breaker} A breakers)`], [String(circuits.length)]]);
    addRow(wTotals, [['Usable per circuit (80%)'], [`${fmt(breaker * USABLE_FRACTION, 1)} A / ${fmt(capVA)} VA`]]);

    wPhaseBox.style.display = threePhase ? 'block' : 'none';
    wThreeNote.style.display = threePhase ? 'block' : 'none';
    wBalance.style.display = threePhase ? 'block' : 'none';
    if (threePhase) {
      ['L1', 'L2', 'L3'].forEach((name, i) => {
        addRow(wPhaseBody, [[name, 'addr'], [String(phaseCount[i])], [fmt(phaseW[i])], [fmt(phaseVA[i])], [`${fmt(phaseVA[i] / LEG_VOLTS, 1)} A`]]);
      });
      const avg = totalVA / 3;
      const worst = Math.max(...phaseVA);
      const pct = avg > 0 ? ((worst - avg) / avg) * 100 : 0;
      wBalance.textContent = `Circuits are spread across L1, L2 and L3, heaviest first. The busiest phase is ${fmt(pct)}% above the average.`;
    }

    const hasZones = circuits.some((c) => c.zone);
    wZoneTh.style.display = hasZones ? '' : 'none';
    const perPhase = [0, 0, 0];
    for (const c of circuits) {
      const idx = threePhase ? ++perPhase[c.phase] : perPhase[0] + 1;
      if (!threePhase) perPhase[0]++;
      const label = threePhase ? `L${c.phase + 1}-${idx}` : String(idx);
      const percent = (c.va / capVA) * 100;
      const over = c.va > capVA + 1e-9;
      const contents = [...c.counts].map(([n, k]) => (k > 1 ? `${n} \u00d7${k}` : n)).join(', ');
      const zoneCell: [string, string?][] = hasZones ? [[c.zone || '\u2014']] : [];
      addRow(wBody, [
        [label, 'addr'],
        ...zoneCell,
        [`${fmt(c.w)} W / ${fmt(c.va)} VA`],
        [`${fmt(c.va / LEG_VOLTS, 1)} A`],
        [over ? `${fmt(percent, 1)}% OVER` : `${fmt(percent, 1)}%`, over ? 'over' : undefined],
        [contents, 'contents']
      ]);
    }
    labelCells(wBody);

    if (warnings.length) {
      wWarning.textContent = warnings.join(' ');
      wWarning.style.display = 'block';
    }
  }

  // ---------- Fixtures per circuit ----------
  const cWatts = document.getElementById('c-watts') as HTMLInputElement;
  const cQty = document.getElementById('c-qty') as HTMLInputElement;
  const cPf = document.getElementById('c-pf') as HTMLInputElement;
  const cNote = document.getElementById('c-note') as HTMLParagraphElement;
  const cOutput = document.getElementById('c-output') as HTMLDivElement;
  const cBody = document.getElementById('c-body') as HTMLTableSectionElement;

  function recalcCircuitCalc() {
    const watts = Number(cWatts.value);
    cBody.innerHTML = '';
    cNote.style.display = 'none';
    if (!(watts > 0)) {
      cOutput.style.display = 'none';
      return;
    }
    let pf = Number(cPf.value);
    if (!(pf >= 0.5 && pf <= 1)) {
      cNote.textContent = 'Power factor must be between 0.5 and 1.0, so 0.9 is being used.';
      cNote.style.display = 'block';
      pf = 0.9;
    }
    const qtyRaw = Math.floor(Number(cQty.value));
    const qty = qtyRaw >= 1 ? Math.min(qtyRaw, 5000) : 0;
    const va = watts / pf;
    for (const breaker of [15, 20, 30]) {
      const cap = LEG_VOLTS * breaker * USABLE_FRACTION;
      const per = Math.floor(cap / va + 1e-9);
      if (per < 1) {
        addRow(cBody, [[`${breaker} A`, 'addr'], [`${fmt(cap)} VA`], ['None: one fixture is over the limit', 'over'], ['\u2014'], ['\u2014']]);
        continue;
      }
      const busiest = Math.min(per, qty || per);
      addRow(cBody, [
        [`${breaker} A`, 'addr'],
        [`${fmt(cap)} VA`],
        [`${fmt(per)}`, 'addr'],
        [qty ? String(Math.ceil(qty / per)) : '\u2014'],
        [`${fmt((busiest * va / cap) * 100, 1)}%`]
      ]);
    }
    cOutput.style.display = 'block';
  }
  [cWatts, cQty, cPf].forEach((el) => el.addEventListener('input', recalcCircuitCalc));
  (document.getElementById('w-goto') as HTMLButtonElement).addEventListener('click', () => showTab(1, true));

  [wPhase, wBreaker].forEach((el) => el.addEventListener('change', () => { saveFixtures(); recalcPower(); }));
  wPf.addEventListener('input', () => { saveFixtures(); recalcPower(); });

  (document.getElementById('p-csv') as HTMLButtonElement).addEventListener('click', () => {
    const header = ['Fixture', 'Universe', 'Start address', 'End universe', 'End address', 'Channels', 'Console', 'Absolute start', 'DIP switches on', 'Watts each', 'Zone'];
    const lines = [header.join(',')];
    for (const p of lastPatch) {
      lines.push(
        [p.label, p.universe, p.address, p.endUniverse, p.end, p.channels, `${p.universe}.${String(p.address).padStart(3, '0')}`, (p.universe - 1) * 512 + p.address, dipOn(p.address), p.watts > 0 ? p.watts : '', p.zone]
          .map(csvCell)
          .join(',')
      );
    }
    const blob = new Blob([lines.join('\n') + '\n'], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'dmx-patch.csv';
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });

  (document.getElementById('p-add') as HTMLButtonElement).addEventListener('click', () => {
    fixtures.push({ name: '', channels: 1, qty: 1, watts: 0, start: '', zone: '' });
    renderFixtureRows();
    recalc();
    const inputs = fixtureList.querySelectorAll<HTMLInputElement>('.fixture-row:last-child input');
    inputs[0]?.focus();
  });

  (document.getElementById('p-clear') as HTMLButtonElement).addEventListener('click', () => {
    if (fixtures.length && !confirm('Clear every fixture from the list?')) return;
    fixtures = [];
    renderFixtureRows();
    recalc();
  });

  [pStartU, pStartA].forEach((el) => el.addEventListener('input', recalc));
  pSplit.addEventListener('change', recalc);
  // Keep the DIP column in sync with the convention chosen on the Addressing tab.
  modeSelect.addEventListener('change', recalc);

  renderFixtureRows();
  recalc();
</script>
