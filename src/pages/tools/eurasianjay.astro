---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Eurasian Jay — image to text (OCR) — corvidae.tools" description="Pull the text out of a screenshot or photo. Paste, drop or choose an image and copy the words. Runs entirely in your browser; nothing is uploaded.">
  <a href="/" class="back-link">&larr; corvidae.tools</a>

  <div style="display: flex; align-items: center; gap: 40px; flex-wrap: wrap; margin-bottom: 8px;">
    <div style="flex: 1; min-width: 260px;">
      <div style="display: flex; align-items: baseline; gap: 12px; margin-bottom: 4px;">
        <h1 style="font-size: 32px; margin: 0;">Eurasian Jay</h1>
        <span style="font-family: var(--font-mono); font-style: italic; font-size: 14px; color: var(--text-faint);">Garrulus glandarius</span>
      </div>
      <p class="tagline" style="margin-top: 8px; margin-bottom: 0;">Pull the text out of a screenshot or photo. Paste an image, drop one in, or choose a file, then copy the words. Everything happens on your device. The picture never leaves your browser.</p>
    </div>
    <img src="/eurasian-jay-mark.webp" alt="" width="220" height="239" style="width: 220px; height: auto; flex-shrink: 0;" />
  </div>

  <div id="dropzone" role="button" tabindex="0" aria-label="Choose an image to read" style="border: 2px dashed var(--border); border-radius: 16px; padding: 48px 32px; text-align: center; cursor: pointer; transition: border-color 0.15s ease, background 0.15s ease; margin-bottom: 32px;">
    <p style="margin: 0 0 8px; font-size: 16px; color: var(--text-muted);">Paste a screenshot (<span id="paste-key">Ctrl+V</span>), drop an image here, or click to choose one</p>
    <p style="margin: 0; font-size: 13px; color: var(--text-faint); font-family: var(--font-mono);">PNG, JPEG, WebP, GIF or BMP &middot; English text &middot; nothing is uploaded</p>
    <input type="file" id="file-input" accept="image/png,image/jpeg,image/webp,image/gif,image/bmp" style="display: none;" />
  </div>

  <div id="work" style="display: none; flex-direction: column; gap: 24px;">
    <div style="display: flex; gap: 32px; flex-wrap: wrap; align-items: flex-end;">
      <div>
        <label for="mode-select" class="ej-label">What kind of picture?</label>
        <select id="mode-select" class="ej-select" style="min-width: 260px;">
          <option value="3">Page or document</option>
          <option value="6">One block of text</option>
          <option value="11">Screenshot with scattered text</option>
        </select>
      </div>
      <label class="ej-check"><input type="checkbox" id="join-lines" /> Join lines into paragraphs</label>
    </div>

    <div style="display: flex; gap: 24px; flex-wrap: wrap; align-items: flex-start;">
      <div id="preview-wrap" class="ej-preview">
        <img id="preview-img" alt="The image being read" />
      </div>
      <div style="flex: 1; min-width: 280px; display: flex; flex-direction: column; gap: 12px;">
        <div id="status" role="status" class="ej-status"></div>
        <div id="bar" class="ej-bar" style="display: none;"><div id="bar-fill"></div></div>
        <label for="result" class="ej-label" style="margin: 0;">Text</label>
        <textarea id="result" rows="12" spellcheck="false" placeholder="The text will appear here. You can fix mistakes before copying."></textarea>
        <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
          <button type="button" id="copy-btn" class="ej-primary" disabled>Copy text</button>
          <button type="button" id="save-btn" class="ej-secondary" disabled>Download .txt</button>
          <button type="button" id="clear-btn" class="ej-secondary">Clear</button>
          <span id="count" class="ej-count"></span>
        </div>
        <p id="notice" class="ej-notice" style="display: none;"></p>
      </div>
    </div>

    <p style="margin: 0; font-size: 13px; line-height: 1.5; color: var(--text-faint); max-width: 640px;">
      Text is recognized with <a href="https://github.com/naptha/tesseract.js" target="_blank" rel="noopener">tesseract.js</a> (Apache-2.0), which downloads once (about 7 MB), only when you first read an image, then works offline. It does best on clear, horizontal, printed text. Handwriting, curved text and very small print will have mistakes, so give the result a read-through before you rely on it.
    </p>
  </div>

  <Footer />
</Layout>

<style is:global>
  .ej-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 8px;
  }
  .ej-select {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 10px 14px;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .ej-check {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
    cursor: pointer;
  }
  .ej-preview {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-card);
    width: 260px;
    max-width: 100%;
    max-height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ej-preview img {
    max-width: 100%;
    max-height: 340px;
    display: block;
  }
  .ej-status {
    min-height: 20px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-muted);
  }
  .ej-status.ej-done {
    color: var(--accent);
  }
  .ej-bar {
    height: 6px;
    border-radius: 3px;
    background: var(--border);
    overflow: hidden;
  }
  .ej-bar > div {
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width 0.2s ease;
  }
  #result {
    width: 100%;
    box-sizing: border-box;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 12px 14px;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.5;
    resize: vertical;
  }
  .ej-primary {
    background: var(--accent);
    border: none;
    color: #0d0d0f;
    padding: 10px 18px;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
  }
  .ej-primary:disabled,
  .ej-secondary:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .ej-secondary {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-dim);
    padding: 10px 16px;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    cursor: pointer;
  }
  .ej-secondary:not(:disabled):hover {
    color: var(--text);
    border-color: var(--text-faint);
  }
  .ej-count {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-faint);
  }
  .ej-notice {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: #e0b374;
  }
  .ej-primary:focus-visible,
  .ej-secondary:focus-visible,
  #result:focus-visible,
  #dropzone:focus-visible,
  .ej-select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  @media (max-width: 560px) {
    .ej-preview {
      width: 100%;
    }
  }
</style>

<script>
  const dropzone = document.getElementById('dropzone') as HTMLDivElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const pasteKey = document.getElementById('paste-key') as HTMLSpanElement;
  const work = document.getElementById('work') as HTMLDivElement;
  const modeSelect = document.getElementById('mode-select') as HTMLSelectElement;
  const joinLines = document.getElementById('join-lines') as HTMLInputElement;
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const statusEl = document.getElementById('status') as HTMLDivElement;
  const bar = document.getElementById('bar') as HTMLDivElement;
  const barFill = document.getElementById('bar-fill') as HTMLDivElement;
  const result = document.getElementById('result') as HTMLTextAreaElement;
  const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
  const countEl = document.getElementById('count') as HTMLSpanElement;
  const notice = document.getElementById('notice') as HTMLParagraphElement;

  const BASE = '/vendor/tesseract';
  const MAX_FILE_BYTES = 50 * 1024 * 1024;
  const MAX_PIXELS = 100_000_000; // refuse pictures this large: decoding them would run the browser out of memory
  const MAX_SIDE = 4000; // bigger pictures are shrunk for recognition: it is slower and no more accurate beyond this
  const MIN_TEXT_SIDE = 1000; // small screenshots are enlarged: the recognizer reads small text poorly

  // Messages that are safe and useful to show on the page; anything else gets a generic line.
  class UserError extends Error {}

  type TessWorker = {
    recognize: (image: Blob) => Promise<{ data: { text: string; confidence: number } }>;
    setParameters: (p: Record<string, string>) => Promise<unknown>;
    terminate: () => Promise<unknown>;
  };

  let enginePromise: Promise<TessWorker> | null = null;
  let currentFile: File | Blob | null = null;
  let currentFileName = 'text';
  let rawText = '';
  let runId = 0;
  let running = false;
  let rerunQueued = false;
  let previewUrl: string | null = null;
  let lastMode = '';

  if (/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) pasteKey.textContent = '⌘V';

  // ---------- small helpers ----------
  function setStatus(text: string, done = false) {
    statusEl.textContent = text;
    statusEl.className = done ? 'ej-status ej-done' : 'ej-status';
  }

  function setProgress(fraction: number | null) {
    if (fraction === null) {
      bar.style.display = 'none';
      return;
    }
    bar.style.display = 'block';
    barFill.style.width = `${Math.round(Math.min(1, Math.max(0, fraction)) * 100)}%`;
  }

  function showNotice(text: string) {
    notice.textContent = text;
    notice.style.display = text ? 'block' : 'none';
  }

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error(`could not load ${src}`));
      document.head.appendChild(s);
    });
  }

  // ---------- the recognizer (loaded once, on first use) ----------
  let progressHook: ((p: number, status: string) => void) | null = null;

  function getEngine(): Promise<TessWorker> {
    if (enginePromise) return enginePromise;
    enginePromise = (async () => {
      setStatus('Loading the text reader (about 7 MB, only the first time)…');
      setProgress(null);
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const w = window as any;
      if (!w.Tesseract) await loadScript(`${BASE}/tesseract.min.js`);
      const worker: TessWorker = await w.Tesseract.createWorker('eng', 1, {
        workerPath: `${BASE}/worker.min.js`,
        corePath: `${BASE}/core`,
        langPath: `${BASE}/lang`,
        workerBlobURL: false, // the page's security policy only allows workers from this site, not blob: ones
        gzip: true,
        cacheMethod: 'none', // the site's offline cache already keeps these files
        logger: (m: { status: string; progress: number }) => progressHook?.(m.progress, m.status)
      });
      return worker;
    })();
    enginePromise.catch(() => {
      enginePromise = null; // let the next attempt try again
    });
    return enginePromise;
  }

  // ---------- preparing the picture ----------
  async function decode(file: Blob): Promise<ImageBitmap | HTMLImageElement> {
    if ('createImageBitmap' in window) {
      try {
        return await createImageBitmap(file);
      } catch {
        /* fall through to an <img> element */
      }
    }
    const url = URL.createObjectURL(file);
    try {
      return await new Promise<HTMLImageElement>((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = () => reject(new UserError('This doesn’t look like an image this browser can open.'));
        img.src = url;
      });
    } finally {
      setTimeout(() => URL.revokeObjectURL(url), 10000);
    }
  }

  // Enlarge small pictures, shrink huge ones, and flip light-on-dark text to dark-on-light,
  // which the recognizer reads far more reliably.
  async function prepare(file: Blob): Promise<{ blob: Blob; inverted: boolean }> {
    const src = await decode(file);
    const sw = 'naturalWidth' in src ? src.naturalWidth : src.width;
    const sh = 'naturalHeight' in src ? src.naturalHeight : src.height;
    if (!sw || !sh) throw new UserError('This doesn’t look like an image this browser can open.');
    if (sw * sh > MAX_PIXELS) {
      if ('close' in src) src.close();
      throw new UserError('This picture is too large to read in a browser tab. Crop it or shrink it first.');
    }
    const longest = Math.max(sw, sh);
    let scale = 1;
    if (longest > MAX_SIDE) scale = MAX_SIDE / longest;
    else if (longest < MIN_TEXT_SIDE) scale = Math.min(3, MIN_TEXT_SIDE / longest);
    const w = Math.max(1, Math.round(sw * scale));
    const h = Math.max(1, Math.round(sh * scale));
    const canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    if (!ctx) throw new UserError('Couldn’t prepare this picture.');
    ctx.fillStyle = '#ffffff'; // transparent areas become white, not black
    ctx.fillRect(0, 0, w, h);
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(src, 0, 0, sw, sh, 0, 0, w, h);
    if ('close' in src) src.close();

    // average brightness from a small sample
    const probe = ctx.getImageData(0, 0, w, h);
    const d = probe.data;
    const step = Math.max(1, Math.floor((w * h) / 40000)) * 4;
    let sum = 0;
    let n = 0;
    for (let i = 0; i < d.length; i += step) {
      sum += 0.299 * d[i] + 0.587 * d[i + 1] + 0.114 * d[i + 2];
      n++;
    }
    const dark = n > 0 && sum / n < 110;
    if (dark) {
      for (let i = 0; i < d.length; i += 4) {
        d[i] = 255 - d[i];
        d[i + 1] = 255 - d[i + 1];
        d[i + 2] = 255 - d[i + 2];
      }
      ctx.putImageData(probe, 0, 0);
    }
    const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/png'));
    canvas.width = canvas.height = 0;
    if (!blob) throw new UserError('Couldn’t prepare this picture.');
    return { blob, inverted: dark };
  }

  // ---------- text ----------
  function tidy(text: string): string {
    const t = text.replace(/\r\n?/g, '\n').replace(/[ \t]+$/gm, '').replace(/\n{3,}/g, '\n\n').trim();
    if (!joinLines.checked) return t;
    return t
      .split(/\n{2,}/)
      .map((p) => p.replace(/(\w)-\n(?=[a-z])/g, '$1').replace(/\n/g, ' ').replace(/ {2,}/g, ' '))
      .join('\n\n');
  }

  function showText() {
    result.value = tidy(rawText);
    updateCount();
  }

  function updateCount() {
    const text = result.value;
    const words = text.trim() ? text.trim().split(/\s+/).length : 0;
    countEl.textContent = text ? `${words} word${words === 1 ? '' : 's'} · ${text.length} characters` : '';
    copyBtn.disabled = !text;
    saveBtn.disabled = !text;
  }

  // ---------- reading ----------
  async function read() {
    if (!currentFile) return;
    if (running) {
      rerunQueued = true;
      return;
    }
    running = true;
    const id = ++runId;
    const file = currentFile;
    showNotice('');
    result.value = '';
    rawText = '';
    updateCount();
    try {
      setStatus('Preparing the picture…');
      setProgress(null);
      const { blob, inverted } = await prepare(file);
      if (id !== runId) return;
      const worker = await getEngine();
      if (id !== runId) return;
      if (lastMode !== modeSelect.value) {
        await worker.setParameters({ tessedit_pageseg_mode: modeSelect.value });
        lastMode = modeSelect.value;
      }
      progressHook = (p, status) => {
        if (id !== runId) return;
        if (status === 'recognizing text') {
          setStatus(`Reading… ${Math.round(p * 100)}%`);
          setProgress(p);
        }
      };
      setStatus('Reading…');
      setProgress(0);
      const { data } = await worker.recognize(blob);
      if (id !== runId) return;
      rawText = data.text || '';
      showText();
      setProgress(null);
      if (!result.value.trim()) {
        setStatus('No text found.');
        showNotice('Nothing readable turned up. Try a different picture type above, or a sharper, larger image.');
      } else {
        const conf = Math.round(data.confidence);
        setStatus(`Done · confidence ${conf}%`, true);
        if (conf < 60) showNotice('The reader wasn’t very sure about this one. Expect mistakes, and check the result against the picture.');
        else if (inverted) showNotice('Light-on-dark text was flipped to dark-on-light before reading.');
      }
    } catch (e) {
      if (id !== runId) return;
      setProgress(null);
      setStatus('');
      showNotice(
        e instanceof UserError
          ? e.message
          : 'Couldn’t read this picture. If this is the first time, the text reader may not have finished downloading; check your connection and try again.'
      );
    } finally {
      progressHook = null;
      running = false;
      if (rerunQueued) {
        rerunQueued = false;
        read();
      }
    }
  }

  // ---------- getting a picture in ----------
  function nameFor(file: File | Blob): string {
    const raw = 'name' in file && (file as File).name ? (file as File).name : '';
    const stem = raw.replace(/\.[^.]*$/, '').replace(/[\u0000-\u001f\u007f\\/:*?"<>|%]/g, '_').replace(/^[.\s]+|[.\s]+$/g, '').slice(0, 80);
    return stem && !/^image$/i.test(stem) ? stem : 'text';
  }

  function accept(file: File | Blob) {
    if (!file.type.startsWith('image/')) {
      work.style.display = 'flex';
      showNotice(/hei[cf]/i.test(file.type) || /\.hei[cf]$/i.test((file as File).name || '')
        ? 'HEIC photos need converting first. Jackdaw can turn them into JPEG, then bring the JPEG here.'
        : 'That doesn’t look like an image. Try a PNG, JPEG or WebP.');
      return;
    }
    if (file.size > MAX_FILE_BYTES) {
      work.style.display = 'flex';
      showNotice('That file is over 50 MB. Crop or shrink it first.');
      return;
    }
    currentFile = file;
    currentFileName = nameFor(file);
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = URL.createObjectURL(file);
    previewImg.src = previewUrl;
    work.style.display = 'flex';
    read();
  }

  function handleFiles(files: FileList | File[] | null | undefined) {
    if (!files || !files.length) return;
    const list = Array.from(files);
    accept(list[0]);
    if (list.length > 1) showNotice('One picture at a time: reading the first one.');
  }

  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.style.borderColor = 'var(--accent)';
  });
  dropzone.addEventListener('dragleave', () => {
    dropzone.style.borderColor = 'var(--border)';
  });
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.style.borderColor = 'var(--border)';
    handleFiles(e.dataTransfer?.files);
  });
  fileInput.addEventListener('change', () => {
    handleFiles(fileInput.files);
    fileInput.value = '';
  });

  // paste a screenshot from the clipboard, anywhere on the page (but not into the text box)
  document.addEventListener('paste', (e) => {
    if (e.target === result) return;
    const items = e.clipboardData?.items;
    if (!items) return;
    for (const item of Array.from(items)) {
      if (item.kind === 'file' && item.type.startsWith('image/')) {
        const f = item.getAsFile();
        if (f) {
          e.preventDefault();
          accept(f);
          return;
        }
      }
    }
  });

  // dropping a picture next to the drop zone shouldn't make the browser navigate to it
  window.addEventListener('dragover', (e) => e.preventDefault());
  window.addEventListener('drop', (e) => {
    if (e.target instanceof Node && dropzone.contains(e.target)) return;
    e.preventDefault();
    handleFiles(e.dataTransfer?.files);
  });

  // ---------- controls ----------
  modeSelect.addEventListener('change', () => read());
  joinLines.addEventListener('change', () => {
    if (rawText) showText();
  });
  result.addEventListener('input', updateCount);

  copyBtn.addEventListener('click', async () => {
    const text = result.value;
    if (!text) return;
    const original = copyBtn.textContent;
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      result.focus();
      result.select();
      document.execCommand('copy');
    }
    copyBtn.textContent = 'Copied';
    setTimeout(() => (copyBtn.textContent = original), 1500);
  });

  saveBtn.addEventListener('click', () => {
    const blob = new Blob([result.value], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${currentFileName}.txt`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 10000);
  });

  clearBtn.addEventListener('click', () => {
    runId++; // abandon any read in progress
    currentFile = null;
    rawText = '';
    result.value = '';
    previewImg.removeAttribute('src');
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = null;
    setStatus('');
    setProgress(null);
    showNotice('');
    updateCount();
    work.style.display = 'none';
  });
</script>
